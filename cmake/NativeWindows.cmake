  src/native_premium.cpp src/native_premium_session.cpp src/native_equipment_rng.cpp
  src/native_dungeons.cpp src/native_mounts.cpp src/native_quests.cpp src/native_quest_session.cpp
  src/native_casting.cpp src/native_cast_session.cpp src/native_gm_equipment.cpp)
