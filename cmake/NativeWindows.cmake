add_library(KarosRuntime SHARED src/native_application.cpp)
target_link_libraries(KarosRuntime PRIVATE rosh_services comctl32 shell32 dbghelp gdi32)
set(role_index 0)
foreach(role LoginServer MainServer LobbyServer WorldServer)
  add_executable(${role} WIN32 src/native_entry.cpp)
  target_compile_definitions(${role} PRIVATE UNICODE _UNICODE "ROSH_ROLE_ID=${role_index}")
  target_link_libraries(${role} PRIVATE KarosRuntime)
  if(MINGW)
    target_link_options(${role} PRIVATE -municode)
  endif()
  math(EXPR role_index "${role_index}+1")
endforeach()
