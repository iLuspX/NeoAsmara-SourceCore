if(NOT WIN32)
  message(FATAL_ERROR "Native services require Windows (Winsock, BCrypt, DPAPI and Win32 UI).")
endif()
set(ROSH_SQLITE_IMPORT_LIBRARY "" CACHE FILEPATH "Windows SDK WinSQLite3 x64 import library")
if(NOT ROSH_SQLITE_IMPORT_LIBRARY)
  file(GLOB sdk_sqlite "C:/Program Files (x86)/Windows Kits/10/Lib/*/um/x64/winsqlite3.lib")
  list(SORT sdk_sqlite COMPARE NATURAL ORDER DESCENDING)
  list(LENGTH sdk_sqlite sdk_count)
  if(sdk_count EQUAL 0)
    message(FATAL_ERROR "Set ROSH_SQLITE_IMPORT_LIBRARY to the x64 Windows SDK winsqlite3.lib.")
  endif()
  list(GET sdk_sqlite 0 ROSH_SQLITE_IMPORT_LIBRARY)
endif()
add_library(rosh_foundation STATIC src/native_core.cpp src/native_accounts.cpp src/native_wire.cpp)
target_include_directories(rosh_foundation PUBLIC include third_party)
target_compile_definitions(rosh_foundation PUBLIC UNICODE _UNICODE _WIN32_WINNT=0x0A00)
target_link_libraries(rosh_foundation PUBLIC "${ROSH_SQLITE_IMPORT_LIBRARY}" bcrypt crypt32 ws2_32)
